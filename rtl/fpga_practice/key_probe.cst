//============================================================
// key_probe.cst —— 按键探测的引脚约束
// 和 demo_es8388.cst 用同一批球号：按键 K6 / H11，灯 D7 / E8
//============================================================

IO_LOC "led[0]" D7;                     // 丝印 LED4（DONE 脚，需开复用）
IO_LOC "led[1]" E8;                     // 丝印 LED3（READY 脚，需开复用）

IO_LOC "key_s1" H11;                    // 丝印 S1（高有效，按下=1）
IO_LOC "key_s2" H10;                    // 丝印 S2（高有效，按下=1）
// ⚠️ 必须下拉！不写的话引脚浮空，松开后被内部弱上拉保持为 1，
//    看到的会是"按一下亮、之后怎么按都不变"，那是假象，不是真实极性。
IO_PORT "key_s1" PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;
IO_PORT "key_s2" PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;
