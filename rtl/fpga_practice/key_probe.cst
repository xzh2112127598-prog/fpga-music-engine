//============================================================
// key_probe.cst —— 按键探测的引脚约束
// 和 demo_es8388.cst 用同一批球号：按键 K6 / H11，灯 D7 / E8
//============================================================

IO_LOC "led[0]" D7;                     // 丝印 LED4（DONE 脚，需开复用）
IO_LOC "led[1]" E8;                     // 丝印 LED3（READY 脚，需开复用）

IO_LOC "key_s1" H11;                    // 丝印 S1（已实测高有效）
IO_LOC "key_s2" H10;                    // 丝印 S2（极性待测）
