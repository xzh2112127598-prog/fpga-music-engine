//============================================================
// 高云物理约束文件（.cst）
// 引脚号 Pxxx 必须照【你这块板子的原理图/引脚图】填写！
// 查询位置：Sipeed Wiki 对应板卡页面的 Pinout 图，或板卡原理图。
// 写完在 Gowin EDA 中把本文件加入工程，再综合布局布线。
//============================================================

// 系统时钟
IO_LOC "clk"   Pxxx;
IO_PORT "clk" PULL_MODE=NONE;

// 复位（若没有专门复位键，可先把某个按键当 rst_n）
IO_LOC "rst_n" Pxxx;
IO_PORT "rst_n" PULL_MODE=UP;

// 用户按键
IO_LOC "key"   Pxxx;
IO_PORT "key" PULL_MODE=UP;

// 4 个 LED
IO_LOC "led[0]" Pxxx;
IO_LOC "led[1]" Pxxx;
IO_LOC "led[2]" Pxxx;
IO_LOC "led[3]" Pxxx;
